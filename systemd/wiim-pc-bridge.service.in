[Unit]
Description=PC and native WiiM group Spotify bridge
Wants=pipewire.service pipewire-pulse.service
After=pipewire.service pipewire-pulse.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=@PROJECT_DIRECTORY@
ExecStartPre=@PROJECT_DIRECTORY@/ensure-runtime.sh
ExecStartPre=/usr/bin/docker compose --env-file @PROJECT_DIRECTORY@/.env up -d --wait --wait-timeout 180 --remove-orphans
ExecStartPre=@PROJECT_DIRECTORY@/bridge.py reconcile --wait-seconds 180
ExecStart=/usr/bin/python3 @PROJECT_DIRECTORY@/volume_handoff.py
ExecStop=-/usr/bin/docker compose --env-file @PROJECT_DIRECTORY@/.env stop
Restart=on-failure
RestartSec=10s
TimeoutStartSec=660
TimeoutStopSec=60

[Install]
WantedBy=default.target
