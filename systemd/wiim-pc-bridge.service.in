[Unit]
Description=PC and native WiiM group Spotify bridge
Wants=pipewire.service pipewire-pulse.service
Wants=wiim-pc-bridge-supervisor.service wiim-pc-bridge-volume.service
After=pipewire.service pipewire-pulse.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# Retry failed startup prerequisites without stopping already-running containers.
Restart=on-failure
RestartSec=30s
WorkingDirectory=@PROJECT_DIRECTORY@
ExecStart=@PROJECT_DIRECTORY@/ensure-runtime.sh
ExecStart=/usr/bin/docker compose --env-file @PROJECT_DIRECTORY@/.env up -d --wait --wait-timeout 180 --remove-orphans
ExecStop=-/usr/bin/docker compose --env-file @PROJECT_DIRECTORY@/.env stop
TimeoutStartSec=660
TimeoutStopSec=60

[Install]
WantedBy=default.target
