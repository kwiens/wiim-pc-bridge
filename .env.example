# Copy this file to .env and edit it for the host running the bridge.
# Keep .env private: it contains machine and home-network details.
BRIDGE_UID=1000
BRIDGE_GID=1000
BRIDGE_RUNTIME_DIR=/run/user/1000
SOLOIST_KEY_FILE=/home/your-user/.config/wiim-pc-bridge/soloist_api_key
PULSE_COOKIE_PATH=/home/your-user/.config/pulse/cookie

DISPLAYPORT_SINK=alsa_output.pci-0000_01_00.1.hdmi-stereo
BRIDGE_SINK=wiim_bridge
BRIDGE_FRIENDLY_NAME="PC + WiiM"

# Reserve these addresses in the router so topology checks remain reliable.
KITCHEN_IP=192.0.2.10
LIVING_ROOM_IP=192.0.2.11
KITCHEN_DEVICE_NAME="Kitchen"
LIVING_ROOM_DEVICE_NAME="Living Room"
WIIM_OUTPUT_NAME="WiiM group (Kitchen leader)"
LOCAL_OUTPUT_NAME="This PC DisplayPort"
TRUSTED_NETWORK=192.0.2.0/24

# Reconciliation restores these values after service startup.
LOCAL_VOLUME=100
WIIM_VOLUME=50
LOCAL_OFFSET_MS=0
WIIM_OFFSET_MS=0
START_BUFFER_MS=2250
