# Copy this file to .env and edit it for the host running the bridge.
# Keep .env private: it contains machine and home-network details.
#
# This file is read by three consumers (the Python tools, the POSIX shell
# helpers, and Docker Compose), so keep values simple: no `$` (Compose would
# expand it), and quote any value containing spaces. A `#` preceded by a space
# starts a comment.
BRIDGE_UID=1000
BRIDGE_GID=1000
BRIDGE_RUNTIME_DIR=/run/user/1000
# Must be outside this repository so it can never be committed.
SOLOIST_KEY_FILE=/home/your-user/.config/wiim-pc-bridge/soloist_api_key
PULSE_COOKIE_PATH=/home/your-user/.config/pulse/cookie

DISPLAYPORT_SINK=alsa_output.pci-0000_01_00.1.hdmi-stereo
BRIDGE_SINK=wiim_bridge
BRIDGE_FRIENDLY_NAME="PC + WiiM"

# Reserve these addresses in the router so topology checks remain reliable.
KITCHEN_IP=192.0.2.10
LIVING_ROOM_IP=192.0.2.11
KITCHEN_DEVICE_NAME="Kitchen"
LIVING_ROOM_DEVICE_NAME="Living Room"
WIIM_OUTPUT_NAME="WiiM group (Kitchen leader)"
LOCAL_OUTPUT_NAME="This PC DisplayPort"

# The LAN that may control OwnTone without authentication. Must be a private
# /8, /16 or /24 with no host bits set: OwnTone matches trusted networks on
# whole dotted octets, so only those prefixes can be expressed exactly. Keep it
# no broader than necessary.
TRUSTED_NETWORK=192.0.2.0/24

# Optional. Every follower the leader should be driving, as ADDRESS=Name pairs
# separated by commas. Leave it unset for a single follower and the
# LIVING_ROOM_* values above are used. Set it to run three speakers, or one:
#   WIIM_FOLLOWERS=192.0.2.11=Living Room,192.0.2.12=Patio
# Reconciliation fails closed unless the leader reports exactly this set.
#WIIM_FOLLOWERS=

# Reconciliation restores these values after service startup.
LOCAL_VOLUME=100
WIIM_VOLUME=50
LOCAL_OFFSET_MS=0
WIIM_OFFSET_MS=0
START_BUFFER_MS=2250
